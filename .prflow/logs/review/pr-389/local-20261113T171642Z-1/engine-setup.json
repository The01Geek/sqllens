table."}, {"file": "src/sqllens/agent/factory.py", "line": 138, "text": "# Outside every guard, so no refusal text names a table, column or function."}, {"file": "src/sqllens/agent/integrations/mysql/sql_runner.py", "line": 49, "text": "remove_sql_modes: ``sql_mode`` flags removed from every query"}, {"file": "src/sqllens/agent/integrations/mysql/sql_runner.py", "line": 78, "text": "self._remove_sql_modes = frozenset(mode.upper() for mode in remove_sql_modes)"}, {"file": "src/sqllens/agent/integrations/mysql/sql_runner.py", "line": 132, "text": "if row is None:"}, {"file": "src/sqllens/agent/integrations/mysql/sql_runner.py", "line": 136, "text": "for mode in str(row[0] or \"\").split(\",\")"}, {"file": "src/sqllens/cli.py", "line": 133, "text": "return [] if loaded is None else loaded.unconfirmed"}, {"file": "src/sqllens/cli.py", "line": 237, "text": "for name in _unconfirmed_rule_sets(cfg):"}], "audit_hints_truncated": true, "views": {"head": {"dir": ".prflow/tmp/review/pr-389/local-20261113T171642Z-1/view-head", "revision": "30f03e90e551ae70e13617df373c05a35f6eb4e9"}, "base": {"dir": ".prflow/tmp/review/pr-389/local-20261113T171642Z-1/view-base", "revision": "ae81b52eea81bbedf5972df4d264938a62ee500a"}}, "dependency_sources": [], "pr": {"number": "389", "body": ".prflow/tmp/review/pr-389/local-20261113T171642Z-1/pr-body.md", "head_ref": "issue-374-per-role-rule-sets-part-1a-mysql-load-rule-sets", "base_ref": "main", "api_head_sha": "30f03e90e551ae70e13617df373c05a35f6eb4e9", "author_trust": "not-looked-up"}, "issue": {"number": "374", "source": "override", "context": ".prflow/tmp/review/pr-389/local-20261113T171642Z-1/issue-context.md"}, "warnings": []}
