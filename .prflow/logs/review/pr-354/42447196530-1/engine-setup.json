e label"}, {"file": "src/sqllens/safety/masking.py", "line": 8, "text": "DataFrame reaches ``RunSqlTool`` and every sink built from it. The rule is a"}, {"file": "src/sqllens/safety/masking.py", "line": 63, "text": "# entries that commonly name non-secret data (``token_count``, ``commit_hash``,"}, {"file": "src/sqllens/safety/masking.py", "line": 64, "text": "# ``pin_code``). Every other built-in entry stays in force, so no setting turns"}, {"file": "src/sqllens/safety/masking.py", "line": 89, "text": "if runs and runs[-1][0] == cls:"}, {"file": "src/sqllens/safety/masking.py", "line": 95, "text": "while i < len(runs):"}, {"file": "tests/unit/test_safety_masking.py", "line": 58, "text": "def test_builtin_entry_list_is_exactly_the_specified_31() -> None:"}, {"file": "tests/unit/test_safety_masking.py", "line": 59, "text": "assert BUILTIN_SECRET_ENTRIES == ("}, {"file": "tests/unit/test_safety_masking.py", "line": 67, "text": "assert len(BUILTIN_SECRET_ENTRIES) == 31"}, {"file": "tests/unit/test_safety_masking.py", "line": 157, "text": "# Removing every removable entry still masks the protected core."}, {"file": "tests/unit/test_safety_masking.py", "line": 232, "text": "return pd.DataFrame([dict(row, id=i) for i in range(n)])"}, {"file": "tests/unit/test_safety_masking.py", "line": 260, "text": "csv_files = list(tmp_path.rglob(\"*.csv\"))"}], "audit_hints_truncated": false, "views": {"head": {"dir": ".prflow/tmp/review/pr-354/42447196530-1/view-head", "revision": "85ce151894e064251556cea7d985f9522d1bbea8"}, "base": {"dir": ".prflow/tmp/review/pr-354/42447196530-1/view-base", "revision": "22ece6c07454ecffde550e9e89e27783f09c4136"}}, "pr": {"number": "354", "body": ".prflow/tmp/review/pr-354/42447196530-1/pr-body.md", "head_ref": "issue-346-hide-secret-column-values", "base_ref": "main", "api_head_sha": "85ce151894e064251556cea7d985f9522d1bbea8", "author_trust": "not-looked-up"}, "issue": {"number": "346", "source": "pr-body", "context": ".prflow/tmp/review/pr-354/42447