    {
      "finding_id": "F-4",
      "agent": "prflow:silent-failure-hunter",
      "severity": "important",
      "description": "The routine refusal message is always the generic 'functions defined in the database are not supported while row-level security is active' and never names the matched call; since matching is by name across every schema and keyword/type tokens before '(' are collected, a built-in call (e.g. max with citext installed) can be refused with a message that misleads the agent about which call to remove.",
      "defect_signature": {
        "file": "src/sqllens/safety/relations.py",
        "line_range": [
          248,
          252
        ],
        "kind": "other"
      },
      "corroboration_count": 1,
      "fix_decision": "applied"
    },
    {
      "finding_id": "F-5",
      "agent": "prflow:requesting-code-review",
      "severity": "suggestion",
      "description": "The child check refuses only relations that are themselves children; under PostgreSQL multiple inheritance (child INHERITS (orders, audit_base) with a rule only on orders), SELECT * FROM audit_base returns the child's rows unfiltered, and the Limitations bullet does not tell operators each parent of a multi-parent child needs its own rule.",
      "defect_signature": {
        "file": "src/sqllens/safety/relations.py",
        "line_range": [
          165,
          189
        ],
        "kind": "other"
      },
      "corroboration_count": 1,
      "fix_decision": "applied"
    }
