every role's scope. Turn it \""}, {"file": "src/sqllens/config.py", "line": 852, "text": "_loaded_at: datetime.datetime | None = PrivateAttr(default=None)"}, {"file": "src/sqllens/config.py", "line": 868, "text": "if self._loaded_at is None:"}, {"file": "src/sqllens/ui/access_rules.html", "line": 8, "text": "through the App SDK's callServerTool and calls no other tool. Do not add a fetch, XHR,"}, {"file": "src/sqllens/ui/access_rules.html", "line": 9, "text": "WebSocket or <script src> to a server origin: every server call must go"}, {"file": "src/sqllens/ui/access_rules.html", "line": 10, "text": "through the host, and tests/unit/test_ui_widget.py asserts it. Do not add"}, {"file": "src/sqllens/ui/access_rules.html", "line": 13, "text": "Every number and rule value arrives as {\"type\", \"text\"}; render the text,"}, {"file": "src/sqllens/ui/access_rules.html", "line": 58, "text": ".entry-list { list-style: none; margin: 0; padding: 0; }"}, {"file": "src/sqllens/ui/access_rules.html", "line": 179, "text": "// A typed value shows its exact text and its type; a list shows each member."}, {"file": "tests/unit/test_access_rules.py", "line": 56, "text": "rule_file: Path | None = None,"}, {"file": "tests/unit/test_access_rules.py", "line": 57, "text": "rls: list[RlsRule] | None = None,"}, {"file": "tests/unit/test_access_rules.py", "line": 64, "text": "auth=AuthConfig(mode=\"none\"),"}, {"file": "tests/unit/test_access_rules.py", "line": 75, "text": "text = \"\".join(getattr(block, \"text\", \"\") for block in result.content)"}, {"file": "tests/unit/test_access_rules.py", "line": 86, "text": "\"\"\"The example row-rule set with all eight kinds, a ``parent_rule`` and a ``link``.\"\"\""}], "audit_hints_truncated": true, "views": {"head": {"dir": ".prflow/tmp/review/pr-406/43734648843-1/view-head", "revision": "ad174ad169217e62febe265c5181f98d7e96fd35"}, "base": {"dir": ".prflow/tmp/review/pr-406/43734648843-1/view-base", "revision": "ae3918ba0445a3217e942c178eac7c1279944ad