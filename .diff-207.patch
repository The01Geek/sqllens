+    assert result.schema_docs_count == 2
+    assert result.skipped_rows == 0
+
+    reparsed = parse_json(out.read_text())
+    assert reparsed.sql_pairs is not None
+    assert {p.sql for p in reparsed.sql_pairs.pairs} == {"SELECT 1", "SELECT 2"}
