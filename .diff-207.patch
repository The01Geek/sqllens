+    out = tmp_path / "out.csv"
+    r = runner.invoke(
+        app,
+        [
+            "export-memory",
+            str(out),
+            "--stream",
+            "--format",
+            "csv",
+            "-c",
+            str(cfg),
+        ],
+    )
+    assert r.exit_code == 1, r.output
+
